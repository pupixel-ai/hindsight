# Keep the community OS/dependency layers; build and install the complete Pupi
# source package, not a runtime or build-time edit of installed Python files.
FROM ghcr.io/vectorize-io/hindsight-api:0.8.5@sha256:35d88f6fc2d63ba37e8118dc02945097bf34e4ad04d4f3299e3c426db72c04ba
USER root
COPY --chown=hindsight:hindsight hindsight-api-slim /app/api
RUN uv pip install --python /app/api/.venv/bin/python --no-deps --reinstall /app/api \
    && /app/api/.venv/bin/python -c "from importlib.metadata import version; assert version('hindsight-api-slim') == '0.8.5+pupi.1'"
ARG SOURCE_REVISION
LABEL org.opencontainers.image.version="0.8.5-pupi.1" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
USER hindsight
